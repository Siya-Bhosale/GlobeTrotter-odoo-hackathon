# ================================================
# GlobeTrotter — Environment Variables
# ================================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to Git
# ================================================

# ── Firebase Authentication ──────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── MySQL Database (Optional) ────────────────────
# If not set, the app runs with an in-memory data store (perfect for demo/dev)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=globetrotter

# ── SMTP Email for OTP (Optional) ───────────────
# If not set, OTP is displayed on screen (dev mode only)
# For Gmail: use an App Password (not your main password)
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
